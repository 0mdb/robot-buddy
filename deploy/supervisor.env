# Robot Buddy Supervisor — Runtime Flags
# Installed to /etc/robot-buddy/supervisor.env
#
# Edit this file to change how the supervisor starts, then restart:
#   sudo systemctl restart robot-buddy-supervisor
#
# All flags are passed verbatim to: python -m supervisor $SUPERVISOR_ARGS
# Run `python -m supervisor --help` for full option list.

# ── Hardware flags ─────────────────────────────────────────────────────────────
# Remove --no-face once the face MCU is wired up and flashed.
# Remove --no-vision to enable the vision worker.
SUPERVISOR_ARGS=--no-face

# ── Examples ───────────────────────────────────────────────────────────────────
# With face MCU:
#   SUPERVISOR_ARGS=--http-port 8080
#
# With planner server on a separate machine:
#   SUPERVISOR_ARGS=--no-face --planner-api http://10.0.0.20:8100 --robot-id robot-1
#
# With custom audio devices:
#   SUPERVISOR_ARGS=--no-face --planner-api http://10.0.0.20:8100 --robot-id robot-1 --usb-speaker-device plughw:1,0 --usb-mic-device plughw:2,0
#
# Enable personality memory (requires parental consent):
#   SUPERVISOR_ARGS=--no-face --memory-consent
#
# Bench / no hardware:
#   SUPERVISOR_ARGS=--mock --no-face --no-vision
#
# Custom serial ports:
#   SUPERVISOR_ARGS=--port /dev/ttyUSB0 --face-port /dev/ttyUSB1

# ── Parent alerts → Home Assistant phone push (optional) ───────────────────────
# When a child asks Buddy to keep a secret or discloses a stranger, unwanted touching, being
# hurt, or being bullied, the dashboard's "For parents" inbox records it. Optionally also push
# to phones (category and time only; the child's words stay on the robot).
#
# Preferred: a Home Assistant automation with a webhook trigger that does the notifying, so
# Buddy holds no HA token and can do nothing else in HA. The URL contains a secret id.
#RB_HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/<secret id>
#
# Alternative: call a notify service with a token (use a dedicated NON-admin HA user).
#RB_HA_URL=http://homeassistant.local:8123
#RB_HA_TOKEN=
#RB_HA_NOTIFY=mobile_app_your_phone
#
# Keep this file private: sudo chmod 600 /etc/robot-buddy/supervisor.env
# NEVER put real values in the copy of this file inside the repo.
