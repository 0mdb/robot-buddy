+    static int FaceCount()
+    {
+        int n = 0;
+        foreach (object bo in (object[])((IPartDoc)doc).GetBodies2((int)swBodyType_e.swSolidBody, true))
+            n += ((IBody2)bo).GetFaceCount();
+        return n;
+    }
+
+    static void Split(string[] f)
+    {
+        int before = FaceCount();
+        double v0 = PartVolume();
+        // the sketch must sit OFF the face it splits (a coplanar sketch projects to nothing):
+        // a reference plane 1 mm above Front, sketch there, project down
+        doc.ClearSelection2(true);
+        doc.Extension.SelectByID2("Front Plane", "PLANE", 0, 0, 0, false, 0, null, 0);
+        IFeature rp = (IFeature)doc.FeatureManager.InsertRefPlane(
+            (int)swRefPlaneReferenceConstraints_e.swRefPlaneReferenceConstraint_Distance, M(1.0), 0, 0, 0, 0);
+        if (rp == null) { Check("split ref plane", false, "InsertRefPlane null"); return; }
+        doc.ClearSelection2(true);
+        rp.Select2(false, 0);
+        doc.SketchManager.InsertSketch(true);
+        doc.SketchManager.AddToDB = true;
+        ISketchManager sm = doc.SketchManager;
+        string[] t = f[1].Split(new char[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
+        double px = 0, py = 0, sx = 0, sy = 0;
+        for (int i = 0; i < t.Length; )
+        {
+            if (t[i] == "M") { px = sx = double.Parse(t[i + 1], ci); py = sy = double.Parse(t[i + 2], ci); i += 3; }
+            else { double x = double.Parse(t[i + 1], ci), y = double.Parse(t[i + 2], ci);
+                   sm.CreateLine(M(px), M(py), 0, M(x), M(y), 0); px = x; py = y; i += 3; }
+        }
+        sm.CreateLine(M(px), M(py), 0, M(sx), M(sy), 0);
+        CloseSketch();
+        IFeature sk = (IFeature)doc.FeatureByPositionReverse(0);
+        double[] at = Nums(f[2]);
+        // the face to split: the planar face at z = 0 (normal +Z) that contains (x, y);
+        // SelectByID2 at a point on the sketch plane picks the sketch region instead
+        IFace2 target = null;
+        foreach (object bo in (object[])((IPartDoc)doc).GetBodies2((int)swBodyType_e.swSolidBody, true))
+            foreach (object fo in (object[])((IBody2)bo).GetFaces())
+            {
+                IFace2 fc = (IFace2)fo;
+                ISurface su = (ISurface)fc.GetSurface();
+                if (!su.IsPlane()) continue;
+                double[] pp = (double[])su.PlaneParams;
+                if (Math.Abs(Math.Abs(pp[2]) - 1) > 1e-9 || Math.Abs(pp[5]) > 1e-9) continue;
+                double[] q = (double[])fc.GetClosestPointOn(M(at[0]), M(at[1]), 0);
+                if (q != null && Math.Abs(q[0] - M(at[0])) < 1e-7 && Math.Abs(q[1] - M(at[1])) < 1e-7 && Math.Abs(q[2]) < 1e-7) { target = fc; break; }
+            }
+        doc.ClearSelection2(true);
+        bool s1 = doc.Extension.SelectByID2(sk.Name, "SKETCH", 0, 0, 0, false, 0, null, 0);
+        bool s2 = target != null && ((IEntity)target).Select2(true, 0);
+        doc.InsertSplitLineProject(false, false);   // IModelDoc2, returns void: face count is the check
+        IFeature last = (IFeature)doc.FeatureByPositionReverse(0);
+        Console.WriteLine("    split: last feature " + last.Name + " [" + last.GetTypeName2() + "]");
+        doc.ClearSelection2(true);
+        doc.EditRebuild3();
+        int after = FaceCount();
+        Check("split at (" + f[2] + ")", after > before && Math.Abs(PartVolume() - v0) < 0.01,
+            string.Format(ci, "sketch sel {0} face sel {1}, faces {2} -> {3}", s1, s2, before, after));
+    }
