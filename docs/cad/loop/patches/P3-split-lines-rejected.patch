+def mount_footprint(side: int) -> list[tuple[float, float]]:
+    """Where mount v2 touches the plate (foot + upright base + end stop), chassis frame.
+    Right = Rz180 of the part frame, left = its X-mirror at identity: x = tx - x_part,
+    y = side * (y_part + ty)."""
+    xa, xb = MM_X
+    part = [
+        (-30.4, -47.0),
+        (xb, -47.0),
+        (xb, MM_FACE),
+        (xa, MM_FACE),
+        (xa, -8.9),
+        (-19.9, -8.9),
+        (-30.4, -18.7),
+    ]
+    tx, ty = mount_tx(), mount_ty()
+    return [(tx - x, side * (y + ty)) for x, y in part]
+
