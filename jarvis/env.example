# Jarvis env file. Copy to ~/.config/jarvis/jarvis.env and chmod 600.
# Kept outside the repo so Jarvis's credentials never sit next to Buddy's .env.

# Bind address. 127.0.0.1 until a LAN client (Buddy's supervisor) needs it.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8200
# JARVIS_DATA_DIR=~/.local/share/jarvis

# Who may use Jarvis (lower-case ids, comma-separated). Empty = nobody.
JARVIS_OWNERS=
# Per-device tokens, name=token (16+ chars). Make one with: openssl rand -hex 24
JARVIS_DEVICE_TOKENS=cli=

# The text client (python -m jarvis.cli) uses these.
JARVIS_CLI_TOKEN=
JARVIS_CLI_USER=

# LLM. Default: the same gemma4 Buddy has loaded on its Ollama (:11435), so no
# extra VRAM. A different model here competes with Buddy's LLM + Orpheus on the 3090 Ti.
JARVIS_OLLAMA_URL=http://127.0.0.1:11435
JARVIS_MODEL=gemma4:26b-a4b-it-qat
# JARVIS_OLLAMA_THINK=0
# JARVIS_MAX_TOOL_ROUNDS=4

# Home Assistant, read tier. A long-lived token from a dedicated HA user, ideally a
# non-admin one. Leave empty to run with no house tools.
JARVIS_HA_URL=
JARVIS_HA_TOKEN=
# Readable entity domains. person / device_tracker / camera left out on purpose.
# JARVIS_HA_DOMAINS=light,switch,sensor,binary_sensor,climate,cover,lock,media_player,fan,weather

# Turns of history fed back as context, and how far back they may be.
# JARVIS_HISTORY_TURNS=6
# JARVIS_HISTORY_WINDOW_S=1800
