# SolidWorks / CAD — binary, no text diff or merge attempts
*.SLDPRT  binary
*.SLDASM  binary
*.SLDDRW  binary
*.SLDLFP  binary
*.PRTDOT  binary
*.ASMDOT  binary
*.DRWDOT  binary

# Neutral CAD exports — binary (both cases; SolidWorks/KiCad export lowercase)
*.STEP    binary
*.step    binary
*.STP     binary
*.stp     binary
*.STL     binary
*.stl     binary
*.3MF     binary
*.3mf     binary
*.IGS     binary
*.igs     binary
*.IGES    binary
*.iges    binary

# If native CAD churns and the repo bloats, switch these to Git LFS:
#   git lfs install && git lfs track "*.SLDPRT" "*.SLDASM" "*.SLDDRW" "*.STEP" "*.3MF"
# (that rewrites the lines above with filter=lfs — do it before committing large parts)

# Git LFS — CAD we author lives in LFS (decided 2026-10-30). Scoped to CAD/ and
# docs/ref/ so the KiCad STEP export under hardware/ stays a plain git blob.
CAD/**/*.SLDPRT   filter=lfs diff=lfs merge=lfs -text
CAD/**/*.SLDASM   filter=lfs diff=lfs merge=lfs -text
CAD/**/*.SLDDRW   filter=lfs diff=lfs merge=lfs -text
CAD/**/*.PRTDOT   filter=lfs diff=lfs merge=lfs -text
CAD/**/*.ASMDOT   filter=lfs diff=lfs merge=lfs -text
CAD/**/*.DRWDOT   filter=lfs diff=lfs merge=lfs -text
CAD/**/*.[Ss][Tt][Ee][Pp] filter=lfs diff=lfs merge=lfs -text
CAD/**/*.[Ss][Tt][Ll]     filter=lfs diff=lfs merge=lfs -text
CAD/**/*.3[Mm][Ff]        filter=lfs diff=lfs merge=lfs -text
docs/ref/*.stp    filter=lfs diff=lfs merge=lfs -text
