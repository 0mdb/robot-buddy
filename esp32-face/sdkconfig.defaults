# Target: ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# TinyUSB for composite device (CDC + UAC) — replaces USB Serial/JTAG console
CONFIG_TINYUSB_CDC_ENABLED=y

# Logging (routed through TinyUSB CDC)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FreeRTOS: both cores enabled
CONFIG_FREERTOS_UNICORE=n

# Task watchdog
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# PSRAM (FNK0104 has 8MB octal PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Performance: the face renders per-pixel in software; -Og + 160 MHz ran ~13 FPS.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 1 ms ticks so the 30 FPS frame period (33 ms) is paced accurately.
CONFIG_FREERTOS_HZ=1000
