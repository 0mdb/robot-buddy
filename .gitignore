# OS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.venv/

# Environment / secrets
.env

# IDE / editor
.vscode/
.idea/

# Claude Code — skills, hooks and shared settings are versioned; local overrides are not
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json

# Build artifacts
build/
dist/
node_modules/

# ESP-IDF
sdkconfig
sdkconfig.old

# KiCad — per-user project state + router logs
*.kicad_prl
hardware/kicad/logs/

# Wake word training (large generated data)
training/.venv/
training/openWakeWord/
training/piper-sample-generator/
training/data/
training/output/

# SolidWorks — lock / temp / backup cruft (tools/sw.py pull excludes these too)
~$*
*.~*
*.SLDBAK
SOLIDWORKS Backup/
SOLIDWORKS Backups/
CAD/**/Backup/

# KiCad transient / local state
*.kicad_prl
*-backups/
_autosave-*
*.lck
~*.lck
fp-info-cache
hardware/kicad/logs/

# Vendor CAD — raw downloads stay out of git (re-fetch per CAD/library/README.md).
# The vendors' native SLDPRT/SLDASM ARE tracked (LFS): assemblies reference them.
CAD/library/vendor/**/*.[Ss][Tt][Ee][Pp]
CAD/library/vendor/**/*.[Ss][Tt][Ll]
CAD/library/vendor/RaspberryPi5/RENDERS/
CAD/library/vendor/RaspberryPi5/Photo/

# SolidWorks Simulation results written next to studied parts (tools/fea.py)
CAD/**/*.CWR
CAD/**/*.gsz
CAD/**/*.LOG
CAD/**/PerformanceLog.txt
CAD/**/*-BenchMark-Solver.txt
CAD/exports/print/*.gcode

# pcb_qc.py review renders (regenerated each run; look, then order)
hardware/kicad/robot-buddy-reflex/qc/

# Eval outputs (L1 conversation suite) — regenerated, never committed
server/eval_out/

# Household data — personality memory, the household roster, daily usage. Robot-local and
# private: never committed (the repo has a remote). The service runs from the repo root
# (deploy/robot-buddy-supervisor.service); `just run` runs from supervisor/.
/data/
/supervisor/data/
